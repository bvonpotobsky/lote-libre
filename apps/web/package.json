{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:layers": "tsx scripts/build-layers.ts",
    "maplibre:worker": "tsx scripts/copy-maplibre-worker.ts",
    "build:landing": "tsx --env-file-if-exists=.env.local scripts/build-landing-assets.ts",
    "build:marca": "tsx scripts/build-marca.ts",
    "build:zonas": "tsx scripts/build-zonas.ts",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local lib/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local lib/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "pnpm maplibre:worker && pnpm db:migrate",
    "prebuild": "pnpm maplibre:worker"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@react-pdf/renderer": "^4.9.0",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "@turf/rewind": "^7.4.0",
    "@turf/turf": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^6.9.0",
    "nanoid": "^6.0.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "terra-draw": "^1.33.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "sharp": "^0.34.5",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
