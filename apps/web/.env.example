# ---------------------------------------------------------------------------
# Lote Limpio — variables de entorno
# Copiá este archivo a apps/web/.env.local y completá los valores.
# Ninguna lleva prefijo NEXT_PUBLIC_: todas son del lado del servidor y el
# bundler nunca las inyecta en el bundle del cliente.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://lote:lote@localhost:5432/lote_limpio"

# Autenticación (Better Auth).
# Generá el secreto con:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Copernicus Data Space Ecosystem — imágenes Sentinel-2.
# 1. Creá una cuenta gratuita en https://dataspace.copernicus.eu
# 2. Entrá al Dashboard -> "OAuth clients" -> crear cliente
# 3. Copiá el client id y el secret que te muestra UNA sola vez
SH_CLIENT_ID=""
SH_CLIENT_SECRET=""

# Vaisala Xweather — nubosidad diaria histórica para elegir la ventana despejada.
# 1. Creá una cuenta en https://www.xweather.com
# 2. Entrá a tu cuenta -> "Apps" -> crear una app
# 3. Copiá el par client id / client secret
XWEATHER_CLIENT_ID=""
XWEATHER_CLIENT_SECRET=""
